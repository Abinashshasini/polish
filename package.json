{
  "name": "polish",
  "productName": "Polish",
  "version": "1.0.0",
  "description": "Fix spelling, grammar and tone anywhere with a hotkey",
  "author": "Abinash",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:ui": "vite build",
    "pack": "npm run build:ui && electron-builder --dir",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "dist:win": "npm run build:ui && electron-builder --win"
  },
  "build": {
    "appId": "com.abinash.polish",
    "productName": "Polish",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Polish uses System Events to paste the fixed text back into your apps."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
