{
  "name": "polish",
  "productName": "Polish",
  "version": "1.0.2",
  "description": "Fix spelling, grammar and tone anywhere with a hotkey",
  "author": "Abinash",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:ui": "vite build",
    "pack": "npm run build:ui && electron-builder --dir",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "dist:win": "npm run build:ui && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "for f in src/*.js src/*/*.js; do node --check \"$f\" || exit 1; done"
  },
  "build": {
    "appId": "com.abinash.polish",
    "productName": "Polish",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Polish uses System Events to paste the fixed text back into your apps."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "diff": "^5.2.2",
    "electron-store": "^8.2.0",
    "openai": "^7.47.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abinashshasini/polish.git"
  }
}
